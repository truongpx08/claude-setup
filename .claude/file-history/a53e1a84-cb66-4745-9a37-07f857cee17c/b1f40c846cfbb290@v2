## WorldSystem

Đăng ký ở **GameCtrl**, sống suốt game.

```csharp
public class WorldSystem
{
    readonly MapConfig[] _allMaps;     // inject qua DI — tất cả MapConfig assets
    readonly SaveSystem _saveSystem;
    readonly SceneLoader _sceneLoader; // wrapper UniTask cho LoadScene

    MapConfig _currentMap;
    bool _isTransitioning;

    public string CurrentMapId => _currentMap.mapId;

    // Gọi khi mở game: load map từ save data
    public async UniTask LoadSavedMap(WorldSaveData data)
    {
        _currentMap = FindMap(data.currentMapId);
        await _sceneLoader.LoadAdditive(_currentMap.sceneName);
        // đặt player tại vị trí đã lưu — SceneCtrl lắng nghe event
        GameBus.Send(new OnMapLoaded
        {
            useEntryPoint = false,
            savedPosition  = data.playerPosition,
            savedRotationY = data.playerRotationY
        });
    }

    // Gọi từ MapTransitionTrigger
    public async UniTask TransitionTo(string mapId, string entryId)
    {
        if (_isTransitioning) return;
        _isTransitioning = true;

        GameBus.Send(new OnMapTransitionStarted());   // → FadeSystem fade out

        var nextMap = FindMap(mapId);
        await _sceneLoader.UnloadScene(_currentMap.sceneName);
        await _sceneLoader.LoadAdditive(nextMap.sceneName);

        _currentMap = nextMap;
        _saveSystem.SaveWorldState(CurrentMapId, GetPlayerPosition());

        GameBus.Send(new OnMapLoaded
        {
            useEntryPoint = true,
            entryId       = entryId
        });

        _isTransitioning = false;
    }

    MapConfig FindMap(string id) =>
        System.Array.Find(_allMaps, m => m.mapId == id);
}
```


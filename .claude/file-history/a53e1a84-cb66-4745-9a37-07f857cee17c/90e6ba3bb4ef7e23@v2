## TileGrid

```csharp
public class TileGrid
{
    public int Width { get; }
    public int Height { get; }

    readonly float _tileSize;        // thường 1f (1 Unity unit = 1 tile)
    readonly Vector3 _origin;        // vị trí world của ô (0,0)
    readonly TileInstance[,] _tiles;

    public TileGrid(int width, int height, float tileSize, Vector3 origin)
    {
        Width     = width;
        Height    = height;
        _tileSize = tileSize;
        _origin   = origin;
        _tiles    = new TileInstance[width, height];

        for (int x = 0; x < width; x++)
        for (int z = 0; z < height; z++)
        {
            _tiles[x, z] = new TileInstance
            {
                coord      = new Vector2Int(x, z),
                type       = TileType.None,
                isWalkable = true,
                isUnlocked = false,
            };
        }
    }

    public TileInstance Get(int x, int z) => _tiles[x, z];
    public TileInstance Get(Vector2Int coord) => _tiles[coord.x, coord.y];

    public bool IsValid(int x, int z) =>
        x >= 0 && x < Width && z >= 0 && z < Height;
}
```


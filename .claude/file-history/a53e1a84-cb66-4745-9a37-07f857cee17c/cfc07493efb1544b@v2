## SceneCtrl nhận OnMapLoaded

Mỗi SceneCtrl lắng nghe `OnMapLoaded` để đặt player đúng vị trí.

```csharp
// trong FarmSceneCtrl (hoặc TownSceneCtrl)
protected override void OnEnter()
{
    GameBus.On<OnMapLoaded>(HandleMapLoaded);
}

protected override void OnExit()
{
    GameBus.Off<OnMapLoaded>(HandleMapLoaded);
}

void HandleMapLoaded(OnMapLoaded msg)
{
    if (msg.useEntryPoint)
    {
        // tìm EntryPoint trong MapConfig → teleport player
        if (_mapConfig.TryGetEntry(msg.entryId, out var entry))
            PlacePlayer(entry.position, entry.rotationY);
    }
    else
    {
        // mở game từ save → đặt nguyên vị trí đã lưu
        PlacePlayer(msg.savedPosition, msg.savedRotationY);
    }
}

void PlacePlayer(Vector3 pos, float rotY)
{
    _player.transform.SetPositionAndRotation(
        pos,
        Quaternion.Euler(0f, rotY, 0f)
    );
}
```

